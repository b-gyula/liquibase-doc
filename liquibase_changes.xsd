            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="minValue" type="xsd:integer">
            <xsd:annotation>
                <xsd:documentation>
                    New minimum value for the sequence
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="cacheSize" type="xsd:integer">
            <xsd:annotation>
                <xsd:documentation>
                    Change the cache size?
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="maxValue" type="xsd:integer">
            <xsd:annotation>
                <xsd:documentation>
                    New maximum value for the sequence
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="dataType" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Data type of the sequence
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="incrementBy" type="xsd:integer">
            <xsd:annotation>
                <xsd:documentation>
                    New amount the sequence should increment by
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="schemaName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the schema
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="sequenceName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="cycle" type="xsd:boolean">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
    </xsd:complexType>

    <xsd:group name="changeSetChildren">
        <xsd:choice>
             <xsd:element name="catalogName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="ordered" type="xsd:boolean" maxOccurs="unbounded"/>
             <xsd:element name="minValue" type="xsd:integer" maxOccurs="unbounded"/>
             <xsd:element name="cacheSize" type="xsd:integer" maxOccurs="unbounded"/>
             <xsd:element name="maxValue" type="xsd:integer" maxOccurs="unbounded"/>
             <xsd:element name="dataType" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="incrementBy" type="xsd:integer" maxOccurs="unbounded"/>
             <xsd:element name="schemaName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="sequenceName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="cycle" type="xsd:boolean" maxOccurs="unbounded"/>
        </xsd:choice>
    </xsd:group>
    <xsd:complexType name="disableTrigger">
        <xsd:annotation>
            <xsd:documentation>
                Disable Trigger
            </xsd:documentation>
        </xsd:annotation>
                <xsd:attribute name="catalogName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the catalog
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="triggerName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
