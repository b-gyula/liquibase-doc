                <xsd:attribute name="defaultValueBoolean" type="xsd:boolean">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="defaultValueConstraintName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="defaultValue" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Default value. Either this property or one of the other defaultValue* properties are required.
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
         
        <xsd:attribute name="defaultValueComputed">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="defaultValueDate" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
         
        <xsd:attribute name="defaultValueSequenceNext">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="schemaName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the schema
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="columnDataType" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Current data type of the column to add default value to
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="columnName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the column to add a default value to
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="defaultValueNumeric" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="tableName" type="xsd:string">
