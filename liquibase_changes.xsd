    <xsd:group name="changeSetChildren">
        <xsd:choice>
             <xsd:element name="catalogName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="triggerName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="scope" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="schemaName" type="xsd:string" maxOccurs="unbounded"/>
