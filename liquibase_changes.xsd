<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://www.liquibase.org/xml/ns/dbchangelog"
            xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
            elementFormDefault="qualified">

    <xsd:complexType name="dropPackage">
        <xsd:annotation>
            <xsd:documentation>
                Drops an existing package
            </xsd:documentation>
        </xsd:annotation>
                <xsd:attribute name="catalogName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the catalog
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="packageName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the package to drop
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="schemaName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the schema
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
    </xsd:complexType>

    <xsd:group name="changeSetChildren">
        <xsd:choice>
             <xsd:element name="catalogName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="packageName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="schemaName" type="xsd:string" maxOccurs="unbounded"/>
        </xsd:choice>
    </xsd:group>
    <xsd:complexType name="addUniqueConstraint">
        <xsd:annotation>
            <xsd:documentation>
                Adds a unique constrant to an existing column or set of columns.
            </xsd:documentation>
        </xsd:annotation>
                <xsd:attribute name="deferrable" type="xsd:boolean">
            <xsd:annotation>
                <xsd:documentation>
                    True if this constraint is deferrable, False otherwise
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="clustered" type="xsd:boolean">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="forIndexName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="constraintName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the unique constraint
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="schemaName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the schema
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="tableName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the table to create the unique constraint on
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="catalogName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the catalog
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="forIndexSchemaName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="tablespace" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    'Tablespace' to create the index in. Corresponds to file group in mssql
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="columnNames" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    Name of the column(s) to create the unique constraint on. Comma separated if multiple
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="disabled" type="xsd:boolean">
            <xsd:annotation>
                <xsd:documentation>
                    True if this constraint is disabled, False otherwise
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="forIndexCatalogName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>
                    
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="initiallyDeferred" type="xsd:boolean">
            <xsd:annotation>
                <xsd:documentation>
                    True if this constraint is initially deferred, False otherwise
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
                <xsd:attribute name="validate" type="xsd:boolean">
            <xsd:annotation>
                <xsd:documentation>
                    This is true if the unique constraint has 'ENABLE VALIDATE' set, or false if the foreign key has 'ENABLE NOVALIDATE' set.
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
    </xsd:complexType>

    <xsd:group name="changeSetChildren">
        <xsd:choice>
             <xsd:element name="deferrable" type="xsd:boolean" maxOccurs="unbounded"/>
             <xsd:element name="clustered" type="xsd:boolean" maxOccurs="unbounded"/>
             <xsd:element name="forIndexName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="constraintName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="schemaName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="tableName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="catalogName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="forIndexSchemaName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="tablespace" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="columnNames" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="disabled" type="xsd:boolean" maxOccurs="unbounded"/>
             <xsd:element name="forIndexCatalogName" type="xsd:string" maxOccurs="unbounded"/>
             <xsd:element name="initiallyDeferred" type="xsd:boolean" maxOccurs="unbounded"/>
             <xsd:element name="validate" type="xsd:boolean" maxOccurs="unbounded"/>
        </xsd:choice>
    </xsd:group>
    <xsd:complexType name="alterSequence">
